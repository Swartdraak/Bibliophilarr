<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\NzbDrone.Host\Bibliophilarr.ico</ApplicationIcon>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <!-- Allow cross-building on Linux/macOS using Windows targeting reference packs.
         This does NOT make Windows functionality runnable on those hosts. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <!-- System.Resources.Extensions is part of the WindowsDesktop reference pack on
       net10.0-windows and is resolved automatically. An explicit reference triggers
       NU1510 (TreatWarningsAsErrors). The WinForms project model loads cleanly without it. -->
  <ItemGroup>
    <ProjectReference Include="..\NzbDrone.Host\Bibliophilarr.Host.csproj" />
    <ProjectReference Include="..\NzbDrone.Windows\Bibliophilarr.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>

