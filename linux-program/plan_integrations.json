{
  "version": 1,
  "task_id": "@TASK@",
  "head_sha": "@HEAD@",
  "deadline_seconds": 900,
  "setup": [
    {
      "name": "prepare_fresh_data_and_ui",
      "argv": [
        "bash",
        "/workspace/linux-program/integrations/prepare.sh"
      ],
      "cwd": "repo",
      "timeout_seconds": 120,
      "env": {
        "CASE_DIR": "/workspace/@CASE@"
      }
    }
  ],
  "services": [
    {
      "name": "bibliophilarr-app",
      "argv": [
        "bash",
        "/workspace/linux-program/build/start_app.sh"
      ],
      "cwd": "repo",
      "env": {
        "DATA_DIR": "/workspace/@CASE@/app-data",
        "APP_PORT": "8765"
      },
      "ready": {
        "url": "http://127.0.0.1:8765/ping",
        "status": 200,
        "timeout_seconds": 120,
        "files": [
          {
            "path": "@CASE@/app-data/config.xml",
            "xml_nonempty": [
              "ApiKey"
            ]
          }
        ]
      }
    }
  ],
  "state_directories": [
    {
      "path": "@CASE@/app-data",
      "mode": "fresh",
      "reason": "Integrations run against a first-boot instance so the live-provider and auth-boundary behavior is observed from a clean config and database"
    }
  ],
  "steps": [
    {
      "name": "check_integrations",
      "argv": [
        "python3",
        "/workspace/linux-program/integrations/check_integrations.py"
      ],
      "cwd": "repo",
      "timeout_seconds": 420,
      "env": {
        "APP_URL": "http://127.0.0.1:8765",
        "CASE_DIR": "/workspace/@CASE@",
        "SEARCH_TERM": "j k rowling"
      },
      "secret_env": {
        "BIBLIOPHILARR_HARDCOVER_API_TOKEN": "HARDCOVER_API_KEY"
      }
    }
  ]
}
