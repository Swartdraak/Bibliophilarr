{
  "version": 1,
  "task_id": "@TASK@",
  "head_sha": "@HEAD@",
  "deadline_seconds": 700,
  "setup": [
    {
      "name": "prepare_fresh_data",
      "argv": [
        "bash",
        "/workspace/linux-program/recovery/prepare.sh"
      ],
      "cwd": "repo",
      "timeout_seconds": 120,
      "env": {
        "CASE_DIR": "/workspace/@CASE@"
      }
    }
  ],
  "services": [
    {
      "name": "bibliophilarr-app",
      "argv": [
        "bash",
        "/workspace/linux-program/build/start_app.sh"
      ],
      "cwd": "repo",
      "env": {
        "DATA_DIR": "/workspace/@CASE@/app-data",
        "APP_PORT": "8765"
      },
      "ready": {
        "url": "http://127.0.0.1:8765/ping",
        "status": 200,
        "timeout_seconds": 120,
        "files": [
          {
            "path": "@CASE@/app-data/config.xml",
            "xml_nonempty": [
              "ApiKey"
            ]
          }
        ]
      }
    }
  ],
  "state_directories": [
    {
      "path": "@CASE@/app-data",
      "mode": "fresh",
      "reason": "Recovery stage boots a fresh instance and then exercises backup/restore boundaries and persistence of the database and config across relaunch"
    }
  ],
  "steps": [
    {
      "name": "check_recovery",
      "argv": [
        "python3",
        "/workspace/linux-program/recovery/check_recovery.py"
      ],
      "cwd": "repo",
      "timeout_seconds": 300,
      "env": {
        "APP_URL": "http://127.0.0.1:8765",
        "CASE_DIR": "/workspace/@CASE@"
      }
    },
    {
      "action": "restart",
      "service": "bibliophilarr-app",
      "signal": "KILL"
    },
    {
      "name": "check_recovery_integrity",
      "argv": [
        "python3",
        "/workspace/linux-program/recovery/check_integrity.py"
      ],
      "cwd": "repo",
      "timeout_seconds": 180,
      "env": {
        "APP_URL": "http://127.0.0.1:8765",
        "CASE_DIR": "/workspace/@CASE@"
      }
    }
  ]
}
